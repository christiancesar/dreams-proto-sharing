{
  "name": "dreams-proto-sharing",
  "version": "2.0.0",
  "main": "index.js",
  "exports": {
    "./src/contracts/*": {
      "import": {
        "types": "./esm/*",
        "default": "./esm/*"
      },
      "require": {
        "types": "./src/contracts/*",
        "default": "./src/contracts/*"
      },
      "default": "./src/contracts/*"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "scripts": {
    "compile": "buf generate && npm run build",
    "build": "node scripts/build-esm.mjs",
    "lint": "buf lint",
    "breaking": "buf breaking --against '.git#branch=main,subdir=src/contracts'"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.74.0",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@types/google-protobuf": "^3.15.12",
    "google-protobuf": "^4.0.3"
  },
  "files": [
    "src/contracts",
    "esm",
    "README.md",
    "README.en.md"
  ],
  "description": "Contratos gRPC (.proto) e código gerado usados pelos microsserviços Dreams",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christiancesar/dreams-proto-sharing.git"
  }
}
